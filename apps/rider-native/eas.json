{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_RIDER_CANDIDATE_FLOW": "true",
        "EXPO_PUBLIC_ENABLE_RIDER_PUSH_REGISTRY": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_RIDER_CANDIDATE_FLOW": "true",
        "EXPO_PUBLIC_ENABLE_RIDER_PUSH_REGISTRY": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
